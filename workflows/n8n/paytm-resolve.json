      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "paytm-resolve",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "paytm-resolve-case"
    },
    {
      "id": "validate-run",
      "name": "Validate run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const b = $json.body; if (!b || !/^resolve_case_[a-f0-9]+$/.test(b.case_id) || !/^run_[a-f0-9]+$/.test(b.run_id)) throw new Error('Invalid case/run schema'); return [{json:{case_id:b.case_id,run_id:b.run_id}}];"
      }
    },
    {
