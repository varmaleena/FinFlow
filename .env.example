# Local-only shared demo token, not production authentication.
DEMO_API_TOKEN=finflow-local-demo
DATABASE_URL=sqlite:///./finflow.db
MONITOR_INTERVAL=15

# --- AI Provider (pick one) ---
# Option 1: Google Gemini (free tier available at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Option 2: OpenAI or any OpenAI-compatible API
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# --- Optional: Voice (Sarvam) ---
# Without a key, browser dictation and speech synthesis are used as fallback.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_SPEAKER=shubh

# --- Optional: n8n workflow automation ---
N8N_WEBHOOK_URL=
WORKFLOW_SECRET=

# --- Optional: Cognee memory (requires extra install + model keys) ---
COGNEE_ENABLED=false

# Paytm Resolve v2. Local demo credentials are public; do not use for hosting.
RESOLVE_DEMO_MODE=true
# JSON mapping secret tokens to server-side identities; when set, replaces demo tokens.
# RESOLVE_IDENTITIES={"private-customer-token":{"role":"customer","merchant_id":"m_001","customer_id":"customer_001"},"private-merchant-token":{"role":"merchant","merchant_id":"m_001"},"private-operations-token":{"role":"operations","merchant_id":"m_001"}}
RESOLVE_N8N_WEBHOOK_URL=
RESOLVE_WORKFLOW_SECRET=
# n8n Cloud variable RESOLVE_API_BASE must point to this backend's public HTTPS URL.

# Vertex AI uses ADC locally and a service identity on Cloud Run.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=spry-catcher-509805-u4
GOOGLE_CLOUD_LOCATION=global
# Optional advisory memory. Store your Cognee Cloud key only in .env / Secret Manager.
COGNEE_BASE_URL=https://api.cognee.ai
COGNEE_API_KEY=
