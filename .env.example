# Local-only shared demo token, not production authentication.
DEMO_API_TOKEN=finflow-local-demo
DATABASE_URL=sqlite:///./finflow.db
MONITOR_INTERVAL=15

# --- AI Provider (pick one) ---
# Option 1: Google Gemini (free tier available at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Option 2: OpenAI or any OpenAI-compatible API
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# --- Optional: Voice (Sarvam) ---
# Without a key, browser dictation and speech synthesis are used as fallback.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_SPEAKER=shubh

# --- Optional: n8n workflow automation ---
N8N_WEBHOOK_URL=
WORKFLOW_SECRET=

# --- Optional: Cognee memory (requires extra install + model keys) ---
COGNEE_ENABLED=false
