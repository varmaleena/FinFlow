{
  "name": "FINFLOW - bounded action and verification",
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "finflow-action",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "wait-before-verification",
      "name": "Wait before verification",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 2,
        "unit": "seconds"
      }
    },
    {
      "id": "verify-first-observation",
      "name": "Verify first observation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/internal/actions/{{ $('Webhook').item.json.body.action_id }}/step?step=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Finflow-Secret",
              "value": "={{ $env.WORKFLOW_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "still-pending",
      "name": "Still pending",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "running",
              "leftValue": "={{ $json.status }}",
              "rightValue": "RUNNING",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "wait-before-recheck",
      "name": "Wait before recheck",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        880,
        -80
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 20,
        "unit": "seconds"
      }
    },
    {
      "id": "verify-or-escalate",
      "name": "Verify or escalate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://api:8000/internal/actions/{{ $('Webhook').item.json.body.action_id }}/step?step=2",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Finflow-Secret",
              "value": "={{ $env.WORKFLOW_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Wait before verification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait before verification": {
      "main": [
        [
          {
            "node": "Verify first observation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify first observation": {
      "main": [
        [
          {
            "node": "Still pending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still pending": {
      "main": [
        [
          {
            "node": "Wait before recheck",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait before recheck": {
      "main": [
        [
          {
            "node": "Verify or escalate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
